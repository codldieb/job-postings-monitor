# Secret used to protect the daily cron endpoint
CRON_SECRET=change-me-to-a-random-string

# Optional: base URL when calling the cron endpoint from an external scheduler
# APP_URL=http://localhost:3000

# Optional local LLM scoring via Ollama (http://localhost:11434)
# Scoring still uses the keyword matcher if this is unset or Ollama is unreachable.
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
